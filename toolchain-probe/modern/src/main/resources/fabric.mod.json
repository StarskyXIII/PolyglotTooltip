{
  "schemaVersion": 1,
  "id": "polyglottoolchainprobe",
  "version": "${mod_version}",
  "name": "Polyglot Toolchain Probe",
  "description": "Minimal multi-loader toolchain verification mod.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.starskyxiii.polyglottoolchainprobe.ToolchainProbe"
    ]
  },
  "mixins": [
    "polyglottoolchainprobe.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
